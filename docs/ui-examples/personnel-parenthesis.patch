+type MonthlyAmount = 'monthlyFringe' | 'monthlyRate' | 'monthlyTotal';
+
+function MonthlyAmountCell({
+  amount,
+  position,
+}: {
+  amount: MonthlyAmount;
+  position: AggregatedPosition;
+}) {
+  const currentDistributions = position.distributions.filter(
+    (distribution) => !distribution.record.isFuture
+  );
+  const canCompare =
+    !position.salaryUnknown &&
+    currentDistributions.length > 0 &&
+    currentDistributions.every((distribution) => !distribution.salaryUnknown);
+  const fundingAmounts = {
+    monthlyFringe: sum(currentDistributions, (d) => d.monthlyFringe),
+    monthlyRate: sum(currentDistributions, (d) => d.monthlyRate),
+    monthlyTotal: sum(currentDistributions, (d) => d.monthlyTotal),
+  };
+  const differs = (key: MonthlyAmount) =>
+    canCompare &&
+    formatCurrency(fundingAmounts[key]) !== formatCurrency(position[key]);
+  const hasDiscrepancy =
+    differs('monthlyRate') ||
+    differs('monthlyFringe') ||
+    differs('monthlyTotal');
+
+  return (
+    <div className="flex w-full flex-col items-end gap-1 text-right">
+      {hasDiscrepancy && (
+        <span className="min-h-5">
+          {differs(amount) && (
+            <span className="text-base-content">
+              <span className="sr-only">Funding distribution total</span>
+              {formatCurrency(fundingAmounts[amount])}
+            </span>
+          )}
+        </span>
+      )}
+      <span
+        className={
+          differs(amount) ? 'text-base-content/80' : 'text-base-content'
+        }
+      >
+        {differs(amount)
+          ? `(${formatAmount(position[amount], position.salaryUnknown)})`
+          : formatAmount(position[amount], position.salaryUnknown)}
+      </span>
+    </div>
+  );
+}
