+}) {
+  return (
+    <span className="min-w-0 sm:min-w-24">
+      <span className="block text-xs text-base-content/70">{label}</span>
+      <span
+        className={`mt-1 block tabular-nums ${emphasis ? 'font-semibold' : 'font-medium'}`}
+      >
+        {formatFundingAmount(value)}
+      </span>
+    </span>
   );
 }

